# Shared location blocks for the HTTP (and optional HTTPS) server.

root /usr/share/nginx/html;
index index.html;

client_max_body_size 5m;
gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;

add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy strict-origin-when-cross-origin always;

# REST API. Synchronous executions can run for minutes: generous read timeout.
location /api/ {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;
}

# Live execution status (WebSocket upgrade)
location /ws/ {
    proxy_pass http://backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
}

# Health check and interactive API docs
location ~ ^/(health|docs|redoc|openapi\.json)$ {
    proxy_pass http://backend;
    proxy_set_header Host $host;
}

# Hashed build assets: cache forever
location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
}

# Single-page app: unknown paths fall back to index.html (client-side routing)
location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
}
