# =============================================================================
# AI Workflow Orchestration Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=orchestrator_dev
POSTGRES_DB=ai_orchestrator
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-in-production

# Async database URL (used by SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator_dev@localhost:5432/ai_orchestrator

# Sync database URL (used by Alembic migrations)
DATABASE_URL_SYNC=postgresql://orchestrator:orchestrator_dev@localhost:5432/ai_orchestrator

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# ---------- LLM API Keys ----------
# At least one key is required for workflow execution.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ---------- Embedding Model ----------
# Options: "openai" (uses text-embedding-3-small) or "local" (uses sentence-transformers)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ---------- Semantic Cache ----------
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# ---------- Execution Engine ----------
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
STAGE_TIMEOUT_SECONDS=120
